# Copy to .env and adjust: cp .env.example .env
# Never commit the real .env.

ENVIRONMENT=local
DEBUG=true

POSTGRES_USER=tollgate
POSTGRES_PASSWORD=tollgate
POSTGRES_DB=tollgate

# Hostnames are the docker compose service names.
DATABASE_URL=postgresql+psycopg://tollgate:tollgate@postgres:5432/tollgate
REDIS_URL=redis://redis:6379/0

# Host ports for reaching the services from your machine (e.g. local pytest).
# Not the usual 8000/5432/6379, so Tollgate can run next to other local stacks.
API_HOST_PORT=8001
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381

# max_tokens applied when a request sends none.
DEFAULT_MAX_TOKENS=1024

# Provider timeouts in seconds: connect, first token, whole answer.
PROVIDER_CONNECT_TIMEOUT_S=5
PROVIDER_FIRST_TOKEN_TIMEOUT_S=30
PROVIDER_TOTAL_TIMEOUT_S=120

# Circuit breaker per provider: failures within the window that open it, and how long it
# stays open before one test request goes through.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_S=30
BREAKER_OPEN_S=30

# Browser origins allowed to call the API (the dashboard), JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# Routes: a name customers ask for -> models to try in order (JSON). Leave unset for the
# default: fast-chat -> Groq, then Gemini.
# ROUTES={"fast-chat": ["groq/llama-3.1-8b-instant", "gemini/gemini-2.5-flash"]}

# The mock provider (model "mock"): delay per answer, answer length, share of failed requests.
MOCK_DELAY_MS=0
MOCK_OUTPUT_TOKENS=32
MOCK_ERROR_RATE=0.0

# Admin key for the /admin routes (at least 32 characters; unset disables them).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Accounts (Phase 0.2). How to get each one: docs/accounts.md ---
# Check them all with: uv run python -m scripts.check_accounts

# LLM providers (free tiers).
GEMINI_API_KEY=
GROQ_API_KEY=

# Stripe TEST mode secret key (sk_test_...). Live keys are refused outside production.
STRIPE_SECRET_KEY=

# Hosted Postgres and Redis. Local runs keep using the compose services above; these
# become DATABASE_URL / REDIS_URL in the deployed app's secrets.
NEON_DATABASE_URL=
UPSTASH_REDIS_URL=

# Hugging Face access token with write access (deploys push to the Space).
HF_TOKEN=
# The Space deploys push to, as owner/name (e.g. your-username/tollgate). When set, the
# check confirms HF_TOKEN can push to it; unset, only that it can write to some repo.
HF_SPACE=
